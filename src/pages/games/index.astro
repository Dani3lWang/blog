---
import PageHeader from "@/components/common/PageHeader.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ClientPagination from "@/components/common/ClientPagination.astro";
import GameCard from "@/components/pages/games/GameCard.astro";
import LifeNavTabs from "@/components/pages/life/LifeNavTabs.astro";
import { gamesConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { GamePlatformId } from "@/types/config";
import type { FlattenedGame } from "@/utils/game-utils";
import { sortGames } from "@/utils/game-utils";

if (!siteConfig.pages.games) {
	return Astro.redirect("/404/");
}

const gamesData = await getCollection("games");
const platformData = gamesData[0]?.data;

const platformMeta: Record<GamePlatformId, { label: string; icon: string }> = {
	steam: { label: "Steam", icon: "simple-icons:steam" },
	switch: { label: "Nintendo Switch", icon: "simple-icons:nintendoswitch" },
	xbox: { label: "Xbox", icon: "simple-icons:xbox" },
	epic: { label: "Epic Games", icon: "simple-icons:epicgames" },
	playstation: { label: "PlayStation", icon: "simple-icons:playstation" },
};

const platformIds: GamePlatformId[] = [
	"steam",
	"switch",
	"xbox",
	"epic",
	"playstation",
];

// 展平平台分组为统一的条目列表
const allGames: FlattenedGame[] = [];
if (platformData) {
	for (const id of platformIds) {
		const list = platformData[id];
		if (Array.isArray(list)) {
			for (const g of list) {
				allGames.push({ ...g, platform: id });
			}
		}
	}
}

const sortBy = gamesConfig.display.sortBy;

interface SectionData {
	id: string;
	label: string;
	icon: string;
	count: number;
	items: FlattenedGame[];
}

const sections: SectionData[] = [];
sections.push({
	id: "all",
	label: i18n(I18nKey.gamesTabAll),
	icon: "material-symbols:grid-view-rounded",
	count: allGames.length,
	items: sortGames(allGames, sortBy),
});
for (const id of platformIds) {
	const items = sortGames(
		allGames.filter((g) => g.platform === id),
		sortBy,
	);
	if (items.length > 0) {
		sections.push({
			id,
			label: platformMeta[id].label,
			icon: platformMeta[id].icon,
			count: items.length,
			items,
		});
	}
}

const defaultPlatform = gamesConfig.display.defaultPlatform;
const activeTab =
	sections.find((s) => s.id === defaultPlatform)?.id ||
	sections[0]?.id ||
	"all";
---

<MainGridLayout title={i18n(I18nKey.gamesTitle)} description={i18n(I18nKey.gamesSubtitle)}>
	<LifeNavTabs mode="records" />
	<div class="games-page-wrapper flex w-full flex-col min-w-0 relative min-h-32">
		<PageHeader headingTag="h2" title={i18n(I18nKey.gamesTitle)} description={i18n(I18nKey.gamesSubtitle)} eyebrow="PLAYING" count={allGames.length} indexTitle />
		<div data-pagefind-body class="card-base z-10 px-6 pt-8 pb-8 relative w-full overflow-hidden">
			{allGames.length > 0 ? (
				<>
					<!-- Platform Tabs -->
					<div class="games-tabs-wrapper mb-6">
						<nav class="flex gap-1 p-1 bg-[var(--btn-regular-bg)] dark:bg-[var(--card-bg)] rounded-xl border border-[var(--line-divider)] overflow-x-auto scrollbar-hide" aria-label="Platforms">
							{sections.map((sec) => (
								<button
									class:list={[
										"games-tab flex items-center gap-1.5 whitespace-nowrap px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 flex-shrink-0",
										sec.id === activeTab
											? "bg-[var(--card-bg)] dark:bg-[var(--btn-regular-bg)] text-[var(--primary)] shadow-sm"
											: "text-[var(--content-meta)] hover:text-[var(--deep-text)] hover:bg-[var(--btn-card-bg-hover)]",
									]}
									data-tab={sec.id}
									type="button"
								>
									<Icon name={sec.icon} class="text-[1.1rem]" />
									<span>{sec.label}</span>
									<span class:list={[
										"text-[10px] font-semibold px-1.5 py-0.5 rounded-full tabular-nums",
										sec.id === activeTab
											? "bg-[var(--primary)]/10 text-[var(--primary)]"
											: "bg-[var(--btn-regular-bg)] text-[var(--content-meta)]",
									]}>
										{sec.count}
									</span>
								</button>
							))}
						</nav>
					</div>

					<!-- Sections -->
					{sections.map((sec) => (
						<div class:list={["games-section", { "hidden": sec.id !== activeTab }]} data-section={sec.id}>
							{sec.items.length > 0 ? (
								<>
									<div class="games-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 md:gap-5">
										{sec.items.map((game) => (
											<div
												class="games-item"
												data-item-section={sec.id}
											>
												<GameCard
													game={game}
													platformIcon={platformMeta[game.platform].icon}
													platformLabel={platformMeta[game.platform].label}
													showAchievements={gamesConfig.display.showAchievements}
												/>
											</div>
										))}
									</div>

									<ClientPagination
										totalItems={sec.items.length}
										itemsPerPage={gamesConfig.display.gamesPerPage}
										itemsPerPageMobile={6}
										currentPage={1}
										sectionId={sec.id}
									/>
								</>
							) : (
								<div class="flex flex-col items-center justify-center py-16 text-center">
									<p class="text-sm text-[var(--content-meta)]">{i18n(I18nKey.gamesNoData)}</p>
								</div>
							)}
						</div>
					))}
				</>
			) : (
				<div class="flex flex-col items-center justify-center py-20 text-center">
					<div class="inline-flex items-center justify-center w-14 h-14 bg-[var(--btn-regular-bg)] rounded-2xl mb-4 border border-[var(--line-divider)]">
						<Icon name="material-symbols:sports-esports-outline" class="w-7 h-7 text-[var(--content-meta)]" />
					</div>
					<h3 class="text-base font-medium text-[var(--deep-text)] dark:text-[var(--title-active)] mb-1.5">
						{i18n(I18nKey.gamesNoData)}
					</h3>
					<p class="text-xs text-[var(--content-meta)]">
						{i18n(I18nKey.gamesSubtitle)}
					</p>
				</div>
			)}
		</div>
	</div>
</MainGridLayout>

<style>
	.games-page-wrapper {
		border-radius: var(--radius-large);
	}

	.games-section {
		animation: fadeIn 0.3s ease-[var(--ease-standard)] both;
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.scrollbar-hide {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.scrollbar-hide::-webkit-scrollbar {
		display: none;
	}

	@media (max-width: 640px) {
		.card-base {
			padding-left: 1rem;
			padding-right: 1rem;
			padding-top: 1.5rem;
			padding-bottom: 1.5rem;
		}
	}
</style>
