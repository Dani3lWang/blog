---
import PageHeader from "@/components/common/PageHeader.astro";
import { getCollection } from "astro:content";
import Comment from "@components/comment/index.astro";
import { Icon } from "astro-icon/components";
import Bookshelf from "@/components/pages/books/Bookshelf.astro";
import LifeNavTabs from "@/components/pages/life/LifeNavTabs.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { removeFileExtension } from "@/utils/url-utils";

if (!siteConfig.pages.books) {
	return Astro.redirect("/404/");
}

const customBangumi = await getCollection("bangumi");

const bookItems = customBangumi
	.filter((item) => item.data.category === "book")
	.sort((a, b) => {
		const dateA = a.data.published?.getTime() || 0;
		const dateB = b.data.published?.getTime() || 0;
		return dateB - dateA;
	})
	.map((item) => {
		const imageSrc =
			typeof item.data.image === "string"
				? item.data.image
				: item.data.image.src;
		const slug = removeFileExtension(item.id);
		const link = `/books/${slug}/`;

		return {
			title: item.data.title,
			coverImage: imageSrc,
			link,
			status: item.data.status,
			score: item.data.score || 0,
		};
	});

const readingCount = bookItems.filter((b) => b.status === 3).length;
const readCount = bookItems.filter((b) => b.status === 2).length;
const wishCount = bookItems.filter((b) => b.status === 1).length;
---

<MainGridLayout title={i18n(I18nKey.booksTitle)} description={i18n(I18nKey.booksSubtitle)}>
	<LifeNavTabs mode="records" />
	<div class="books-page-wrapper flex w-full flex-col min-w-0 relative min-h-32">
		<PageHeader headingTag="h2" title={i18n(I18nKey.booksTitle)} description={i18n(I18nKey.booksSubtitle)} eyebrow="READING" count={bookItems.length} indexTitle>
			<span slot="meta">{i18n(I18nKey.bookshelfRead)} <strong>{readCount}</strong></span>
			<span slot="meta">{i18n(I18nKey.bookshelfReading)} <strong>{readingCount}</strong></span>
			<span slot="meta">{i18n(I18nKey.bookshelfWantRead)} <strong>{wishCount}</strong></span>
		</PageHeader>
		<div data-pagefind-body class="card-base z-10 px-6 pt-8 pb-8 relative w-full overflow-hidden">
			{bookItems.length > 0 ? (
				<Bookshelf books={bookItems} />
			) : (
				<div class="flex flex-col items-center justify-center py-20 text-center">
					<div class="inline-flex items-center justify-center w-14 h-14 bg-[var(--btn-regular-bg)] rounded-2xl mb-4 border border-[var(--line-divider)]">
						<Icon name="material-symbols:book-5-outline" class="w-7 h-7 text-[var(--content-meta)]" />
					</div>
					<h3 class="text-base font-medium text-[var(--deep-text)] dark:text-[var(--title-active)] mb-1.5">
						{i18n(I18nKey.booksNoData)}
					</h3>
				</div>
			)}
		</div>
	</div>

	<Comment customPath="/books/" />
</MainGridLayout>

<style>
	.books-page-wrapper {
		border-radius: var(--radius-large);
	}

	@media (max-width: 640px) {
		.card-base {
			padding-left: 1rem;
			padding-right: 1rem;
			padding-top: 1.5rem;
			padding-bottom: 1.5rem;
		}
	}
</style>
