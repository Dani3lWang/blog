---
interface Props {
	title: string;
	description?: string;
	eyebrow?: string;
	count?: number | string;
	headingTag?: "h1" | "h2";
	indexTitle?: boolean;
}

const {
	title,
	description,
	eyebrow,
	count,
	headingTag: Heading = "h1",
	indexTitle = false,
} = Astro.props;
---

<header class="content-header" data-pagefind-body={indexTitle || undefined}>
	{eyebrow && <p class="content-header__eyebrow" aria-hidden="true">{eyebrow}</p>}
	<div class="content-header__row">
		<Heading
			class="content-header__title"
			data-pagefind-meta={indexTitle ? "title" : undefined}
			data-pagefind-weight={indexTitle ? "10" : undefined}
		>{title}</Heading>
		{count !== undefined && <span class="content-header__count" data-pagefind-ignore>{count}</span>}
	</div>
	{description && <p class="content-header__description">{description}</p>}
	{Astro.slots.has("meta") && <div class="content-header__meta"><slot name="meta" /></div>}
</header>

<style>
	.content-header {
		position: relative;
		min-width: 0;
		margin-bottom: 24px;
		padding-block: 4px 20px;
		border-bottom: 1px solid var(--ed-frame);
	}

	.content-header::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -1px;
		width: 48px;
		height: 2px;
		background: var(--ed-guava-coral);
	}

	.content-header__eyebrow {
		margin: 0 0 8px;
		font-family: var(--font-editorial-mono);
		font-size: 12px;
		line-height: 1.5;
		letter-spacing: 0.18em;
		color: var(--ed-ink-faint);
	}

	.content-header__row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px 20px;
	}

	.content-header__title {
		min-width: 0;
		margin: 0;
		font-family: var(--font-editorial-serif);
		font-size: clamp(28px, 1.2rem + 1.6vw, 38px);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.02em;
		color: var(--ed-ink);
		overflow-wrap: anywhere;
	}

	.content-header__count {
		font-family: var(--font-editorial-mono);
		font-size: 14px;
		font-variant-numeric: tabular-nums;
		line-height: 1.5;
		color: var(--ed-ink-faint);
	}

	.content-header__description {
		max-width: 46em;
		margin: 10px 0 0;
		font-size: max(14px, 1rem);
		line-height: 1.75;
		color: var(--ed-ink-soft);
	}

	.content-header__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-top: 12px;
		font-size: max(13px, 0.875rem);
		line-height: 1.6;
		color: var(--ed-ink-faint);
	}

	.content-header__meta :global(strong) {
		margin-inline-start: 4px;
		font-variant-numeric: tabular-nums;
		color: var(--ed-ink);
	}
</style>
