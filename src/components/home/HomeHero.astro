---
import { Icon } from "astro-icon/components";
import { homeConfig } from "@/config";
import type { HomeRandomCandidate } from "@/utils/home-utils";
import { url } from "@/utils/url-utils";

/**
 * 首页内容导览
 *
 * 首页负责把访客送往内容，不重复 /about/ 的个人资料。
 * 左侧是本期导语和阅读操作，右侧以目录形式列出文章、动态和生活记录。
 */
interface Props {
	/** 随机阅读候选池；为空时不渲染「换一篇」 */
	randomPool: HomeRandomCandidate[] | null;
}

const { randomPool } = Astro.props;

const hero = homeConfig.hero;
const postsUrl = url("/posts/");
const dispatchLinks = [
	{
		number: "01",
		label: "文章",
		description: "长文、随笔与完整归档",
		href: postsUrl,
	},
	{
		number: "02",
		label: "动态",
		description: "最近发生的生活切片",
		href: url("/dynamic/"),
	},
	{
		number: "03",
		label: "生活索引",
		description: "书影音、游戏与去过的地方",
		href: "#life-index",
	},
];
---

<section class="ed-hero onload-animation ed-section" style="--ed-delay: 60ms">
  <div class="ed-hero__main">
    {hero.kicker && <p class="ed-hero__kicker">{hero.kicker}</p>}
    <p class="ed-hero__title">{homeConfig.brand.tagline}</p>
    {hero.introduction && <p class="ed-hero__intro">{hero.introduction}</p>}

    <div class="ed-hero__actions">
      <a class="ed-action ed-action--solid" href={postsUrl}>
        <Icon name="material-symbols:article-outline" class="text-[1.05rem]" />
        {hero.primaryAction}
      </a>
      {randomPool && randomPool.length > 0 && (
        <button
          type="button"
          class="ed-action"
          id="home-random-post"
          data-candidates={JSON.stringify(randomPool)}
        >
          <Icon name="material-symbols:casino-outline" class="text-[1.05rem]" />
          换一篇
        </button>
      )}
    </div>
  </div>

  <nav class="ed-dispatch" aria-label="首页内容导览">
    <div class="ed-dispatch__head">
      <span>CONTENTS</span>
      <span aria-hidden="true">↘</span>
    </div>
    <p class="ed-dispatch__title">从这里开始</p>
    <div class="ed-dispatch__list">
      {dispatchLinks.map((item) => (
        <a class="ed-dispatch__item" href={item.href}>
          <span class="ed-dispatch__number">{item.number}</span>
          <span class="ed-dispatch__copy">
            <strong>{item.label}</strong>
            <small>{item.description}</small>
          </span>
          <Icon name="material-symbols:arrow-outward-rounded" class="ed-dispatch__arrow" />
        </a>
      ))}
    </div>
  </nav>
</section>

<script>
  // 「换一篇」：候选池在构建期注入，点击时在客户端随机挑一篇再跳转，
  // 保证每次点到的不一样（静态站无法在构建期做到真随机）。
  function initHomeRandomPost() {
    const button = document.getElementById("home-random-post");
    if (!button || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    button.addEventListener("click", () => {
      let candidates = [];
      try {
        candidates = JSON.parse(button.dataset.candidates || "[]");
      } catch {
        candidates = [];
      }
      if (candidates.length === 0) return;

      const pick = candidates[Math.floor(Math.random() * candidates.length)];
      if (!pick?.href) return;

      if (window.swup) {
        window.swup.navigate(pick.href);
      } else {
        window.location.href = pick.href;
      }
    });
  }

  initHomeRandomPost();

  // 防止 Swup 切页重跑脚本时重复注册监听器（与站内其他初始化守卫同一写法）
  if (!window.__homeRandomPostInit) {
    window.__homeRandomPostInit = true;
    document.addEventListener("swup:contentReplaced", initHomeRandomPost);
    document.addEventListener("astro:page-load", initHomeRandomPost);
  }
</script>
