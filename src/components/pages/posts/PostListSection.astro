---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

/**
 * 文章列表（/posts/、/posts/2/ …）
 *
 * 首页换成个人主页后，完整文章列表迁到这里。
 * 页面骨架与原来的首页列表保持一致，只补一个编辑式的可见标题，
 * 让 /posts/ 在单独访问时有明确的页面身份。
 */
interface Props {
	page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;

const len = page.data.length;
const listTitle = i18n(I18nKey.homeAllPosts);
const rangeStart = page.total === 0 ? 0 : page.start + 1;
---

<div class="post-archive-list">
  <header class="post-archive-head">
    <p class="post-archive-kicker">ARCHIVE</p>
    <div class="post-archive-title-row">
      <h2 class="post-archive-title">{listTitle}</h2>
      {
        page.total > 0 && (
          <p class="post-archive-count">
            {rangeStart}-{page.end} / {page.total}
          </p>
        )
      }
    </div>
    <div class="post-archive-rule" aria-hidden="true"></div>
  </header>

  <PostPage page={page} />

  {
    page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        basePath="/posts/"
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</div>

<style>
  .post-archive-list {
    display: flex;
    flex-direction: column;
  }

  .post-archive-head {
    margin-bottom: 1.5rem;
  }

  .post-archive-kicker {
    margin: 0 0 0.35rem;
    font-family: var(--font-editorial-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ed-ink-faint, rgba(0, 0, 0, 0.45));
  }

  .post-archive-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-archive-title {
    margin: 0;
    font-family: var(--font-editorial-serif, serif);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.3rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--ed-ink, inherit);
  }

  .post-archive-count {
    margin: 0;
    font-family: var(--font-editorial-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ed-ink-faint, rgba(0, 0, 0, 0.45));
  }

  .post-archive-rule {
    margin-top: 0.85rem;
    height: 2px;
    background: var(--ed-frame, currentColor);
    opacity: 0.9;
  }
</style>
