---
import PageHeader from "@/components/common/PageHeader.astro";
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

/**
 * 文章列表（/posts/、/posts/2/ …）
 *
 * 首页换成个人主页后，完整文章列表迁到这里。
 * 页面骨架与原来的首页列表保持一致，只补一个编辑式的可见标题，
 * 让 /posts/ 在单独访问时有明确的页面身份。
 */
interface Props {
	page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;

const len = page.data.length;
const listTitle = i18n(I18nKey.homeAllPosts);
const rangeStart = page.total === 0 ? 0 : page.start + 1;
---

<div class="post-archive-list">
  <PageHeader
    title={listTitle}
    eyebrow="ARCHIVE"
    headingTag="h2"
    count={page.total > 0 ? `${rangeStart}-${page.end} / ${page.total}` : undefined}
  />

  {page.total > 0 ? <PostPage page={page} /> : <p class="card-base p-6 text-(--content-meta)">{i18n(I18nKey.postsEmpty)}</p>}

  {
    page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        basePath="/posts/"
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</div>

<style>
  .post-archive-list {
    display: flex;
    flex-direction: column;
  }

</style>
