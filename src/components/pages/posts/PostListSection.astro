---
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "@/components/common/Pagination.astro";
import ArticleIndexCard from "@/components/pages/posts/ArticleIndexCard.astro";
import { getCategoryList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

/**
 * 文章列表（/posts/、/posts/2/ …）
 *
 * 首页换成个人主页后，完整文章列表迁到这里。
 * 页面骨架与原来的首页列表保持一致，只补一个编辑式的可见标题，
 * 让 /posts/ 在单独访问时有明确的页面身份。
 */
interface Props {
	page: Page<CollectionEntry<"posts">>;
}

const { page } = Astro.props;

const len = page.data.length;
const categories = await getCategoryList();
const featuredEntries =
	page.currentPage === 1 ? page.data.filter((entry) => entry.data.pinned) : [];
const regularEntries = page.data.filter(
	(entry) => page.currentPage !== 1 || !entry.data.pinned,
);

function getAccentHue(category: string | null, index: number): number {
	const source = category?.trim() || `post-${index}`;
	let hash = 0;
	for (const char of source) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
	return (hash + 12) % 360;
}
---

<div class="post-index-layout">
	<aside class="post-index-directory" aria-label="文章分类">
		<div class="post-index-side-sticky">
			<p class="post-index-side-label">文章</p>
			<nav class="post-index-directory__nav">
				<a href={url("/posts/")} class="post-index-directory__item is-active" aria-current="page">
					<span class="post-index-directory__name">
						<Icon name="material-symbols:article-outline-rounded" />
						全部文章
					</span>
					<span class="post-index-directory__count">{page.total}</span>
				</a>
				{
					categories.map((category) => (
						<a href={category.url} class="post-index-directory__item">
							<span class="post-index-directory__name">{category.name}</span>
							<span class="post-index-directory__count">{category.count}</span>
						</a>
					))
				}
			</nav>
		</div>
	</aside>

	<section class="post-index-main" aria-labelledby="post-index-title">
		<header class="post-index-header">
			<p>ARTICLE INDEX</p>
			<h2 id="post-index-title">文章列表</h2>
		</header>

		{
			featuredEntries.length > 0 && (
				<section class="post-index-featured" aria-labelledby="post-index-featured-title">
					<h2 id="post-index-featured-title" class="post-index-section-title post-index-section-title--featured">
						置顶
					</h2>
					<div class="post-index-featured__list">
						{featuredEntries.map((entry, index) => (
							<ArticleIndexCard
								entry={entry}
								variant="featured"
								accentHue={getAccentHue(entry.data.category, index)}
								loading={index === 0 ? "eager" : "lazy"}
							/>
						))}
					</div>
				</section>
			)
		}

		<section class="post-index-articles" aria-labelledby="post-index-articles-title">
			<div class="post-index-articles__heading">
				<h2 id="post-index-articles-title" class="post-index-section-title">文章</h2>
				<p>共 <strong>{page.total}</strong> 篇文章</p>
			</div>

			{
				regularEntries.length > 0 ? (
					<div class="post-index-card-grid">
						{regularEntries.map((entry, index) => (
							<ArticleIndexCard
								entry={entry}
								accentHue={getAccentHue(entry.data.category, index + featuredEntries.length)}
								loading={index < 3 && featuredEntries.length === 0 ? "eager" : "lazy"}
							/>
						))}
					</div>
				) : (
					<p class="post-index-empty">这一页的文章都已展示在置顶区域。</p>
				)
			}
		</section>

		{
			page.total > page.size && (
				<Pagination
					class="post-index-pagination onload-animation"
					page={page}
					basePath="/posts/"
					style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
				/>
			)
		}
	</section>

	<aside class="post-index-toc" aria-label="目录">
		<div class="post-index-side-sticky">
			<p class="post-index-side-label">目录</p>
			<div class="post-index-toc__empty">
				<span aria-hidden="true"></span>
				<p>当前页面没有目录</p>
			</div>
		</div>
	</aside>
</div>
